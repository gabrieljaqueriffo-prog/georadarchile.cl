<div class="trust-strip" aria-label="Credenciales de Geo Radar Chile">
  <div class="shell trust-strip-inner">
    <span>Empresa desde 2011</span>
    <span>Experiencia en GPR desde 1997</span>
    <span>Más de 250 proyectos</span>
    <span>0 accidentes</span>
  </div>
</div>
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand-logo" href="/" aria-label="Geo Radar Chile, inicio"><img src="/assets/images/georadar-chile-logo-corporativo.png" width="3295" height="675" alt="Geo Radar Chile"></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-menu">Menú</button>
    <nav id="main-menu" class="main-nav" aria-label="Navegación principal">
      <ul>{% for item in navigation %}<li><a href="{{ item.url }}">{{ item.label }}</a></li>{% endfor %}</ul>
      <a class="header-cta" href="/contacto/">Solicitar cotización</a>
    </nav>
  </div>
</header>
