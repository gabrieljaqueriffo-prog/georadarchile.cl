<div class="trust-strip" aria-label="Credenciales de Geo Radar Chile">
  <div class="shell trust-strip-inner">
    <span>Empresa desde 2011</span>
    <span>Experiencia en GPR desde 1997</span>
    <span>{{ site.projects.text }}</span>
    <span>0 accidentes</span>
  </div>
</div>
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand-logo" href="/" aria-label="Geo Radar Chile, inicio"><img src="/assets/images/georadar-chile-logo-corporativo.png" loading="eager" sizes="260px" alt="Geo Radar Chile"></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-menu">Menú</button>
    <nav id="main-menu" class="main-nav" aria-label="Navegación principal">
      <ul>{% for item in navigation %}<li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>{% if item.children %}<ul class="main-nav-sub">{% for child in item.children %}<li><a href="{{ child.url }}"{% if page.url == child.url %} aria-current="page"{% endif %}>{{ child.label }}</a></li>{% endfor %}</ul>{% endif %}</li>{% endfor %}</ul>
      <a class="header-cta" href="/contacto/">Solicitar cotización</a>
    </nav>
  </div>
</header>
