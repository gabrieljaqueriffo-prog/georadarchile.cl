<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }} | {{ site.name }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <meta name="robots" content="{{ robots or 'index,follow' }}">
    <link rel="canonical" href="{{ site.canonicalOrigin }}{{ page.url }}">
    <meta property="og:locale" content="{{ site.locale }}">
    <meta property="og:type" content="{{ route.ogType or 'website' }}">
    <meta property="og:title" content="{{ title }} | {{ site.name }}">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:url" content="{{ site.canonicalOrigin }}{{ page.url }}">
    {% if route.ogImage %}<meta property="og:image" content="{{ site.canonicalOrigin }}{{ route.ogImage }}">{% endif %}
    {% if route.datePublished %}<meta property="article:published_time" content="{{ route.datePublished }}">{% endif %}
    {% if route.dateModified %}<meta property="article:modified_time" content="{{ route.dateModified }}">{% endif %}
    <script type="application/ld+json">{{ {"@context":"https://schema.org","@type":"Organization","name":site.name,"url":site.canonicalOrigin,"email":site.contact.email,"telephone":site.contact.phoneDisplay,"sameAs":[site.atlasUrl]} | dump | safe }}</script>
    <script type="application/ld+json">{{ {"@context":"https://schema.org","@type":"WebSite","name":site.name,"url":site.canonicalOrigin,"inLanguage":site.locale} | dump | safe }}</script>
    {% if route.url == '/instrumentos/' %}
    <script type="application/ld+json">{{ {"@context": "https://schema.org", "@type": "WebPage", "name": title, "description": description, "url": site.canonicalOrigin + page.url, "about": [{"@type": "Thing", "name": "IDS GeoRadar Chaser XR"}, {"@type": "Thing", "name": "IDS GeoRadar Stream DP"}, {"@type": "Thing", "name": "IDS GeoRadar Opera XR"}, {"@type": "Thing", "name": "IDS GeoRadar C-thrue"}, {"@type": "Thing", "name": "Leica DS2000"}, {"@type": "Thing", "name": "Leica DS4000"}, {"@type": "Thing", "name": "Localización electromagnética"}], "isPartOf": {"@type": "WebSite", "name": site.name, "url": site.canonicalOrigin} } | dump | safe }}</script>
    <script type="application/ld+json">{{ {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Inicio", "item": site.canonicalOrigin + "/"}, {"@type": "ListItem", "position": 2, "name": "Tecnología", "item": site.canonicalOrigin + page.url}] } | dump | safe }}</script>
    {% endif %}
    <link rel="stylesheet" href="/assets/css/site.css?v=20260929">
    <script src="/assets/js/site.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    {% include "components/header.njk" %}
    <main id="contenido">{{ content | safe }}</main>
    {% if page.url != '/' and page.url != '/search/' and page.url != '/contacto/' and page.url != '/vista-mobile/' %}
    <nav class="floating-actions" aria-label="Acciones rápidas" data-floating-actions>
      <button class="floating-top" type="button" aria-label="Volver al inicio de la página" data-back-to-top>
        <span>Subir</span><b aria-hidden="true">↑</b>
      </button>
      <a class="floating-whatsapp" href="https://wa.me/56975909836" target="_blank" rel="noopener noreferrer" aria-label="Consultar por WhatsApp con Geo Radar Chile">
        <i aria-hidden="true">WA</i><span><small>CONSULTA DIRECTA</small>WhatsApp</span><b aria-hidden="true">↗</b>
      </a>
    </nav>
    {% endif %}
    {% include "components/footer.njk" %}
  </body>
</html>
