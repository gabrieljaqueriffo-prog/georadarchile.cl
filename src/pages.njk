      conductors: { title: 'Conductores y cables', copy: 'La localización electromagnética ayuda a seguir conductores cuando existe una señal aplicable o detectable y debe contrastarse con el contexto.', equipment: 'LEM y radiodetección, con apoyo GPR', complement: 'Planos, continuidad y verificación en terreno', limit: 'Material no conductor, acoplamiento y falta de continuidad' }
