    choices.forEach(choice => choice.addEventListener('click', () => { const item = choiceData[choice.dataset.instrumentChoice]; choices.forEach(button => { const active = button === choice; button.classList.toggle('is-active', active); button.setAttribute('aria-pressed', active ? 'true' : 'false'); }); Object.keys(target).forEach(key => { target[key].textContent = item[key]; }); }));
    const spectrum = document.querySelectorAll('[data-spectrum]');
    const spectrumData = {
      80: ['80 MHz', 'Rango amplio de inspección', 'Chaser XR y Opera XR declaran rangos de inspección que incluyen esta referencia. El alcance relativo depende de la condición del terreno y del objetivo.'],
      200: ['200 MHz', 'Contrastes de mayor escala', 'Aparece en RIS MF HiMod, Opera XR y DS4000. Es una referencia útil para comparar respuestas de mayor escala, no una profundidad garantizada.'],
