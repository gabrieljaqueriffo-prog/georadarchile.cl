<script>
  (() => {
    const buttons = document.querySelectorAll('[data-case-filter]');
    const cards = document.querySelectorAll('[data-case-sector]');
    const status = document.querySelector('#cases-filter-status');
    const grid = document.querySelector('.cases-portfolio-grid');
    if (!buttons.length || !cards.length || !status || !grid) return;
    buttons.forEach(button => button.addEventListener('click', () => {
      const filter = button.dataset.caseFilter;
      let visible = 0;
      buttons.forEach(item => { const active = item === button; item.classList.toggle('is-active', active); item.setAttribute('aria-pressed', String(active)); });
      cards.forEach(card => { const show = filter === 'all' || card.dataset.caseSector === filter; card.hidden = !show; if (show) visible += 1; });
      grid.dataset.visible = String(visible);
      const label = filter === 'all' ? 'referencias seleccionadas' : `referencias de ${button.childNodes[0].textContent.trim()}`;
      status.textContent = `Mostrando ${visible} ${label}.`;
    }));
  })();
</script>

