<section class="search-workspace"><div class="shell">
  <header class="search-toolbar"><div><p class="home-section-tag">Índice del sitio</p><h2>Resultados disponibles</h2></div><p data-search-status aria-live="polite">Mostrando una selección inicial.</p></header>
  <div class="search-filters" role="group" aria-label="Filtrar resultados"><button type="button" class="is-active" data-search-filter="all" aria-pressed="true">Todo</button><button type="button" data-search-filter="Servicios" aria-pressed="false">Servicios</button><button type="button" data-search-filter="Industrias" aria-pressed="false">Industrias</button><button type="button" data-search-filter="Blog" aria-pressed="false">Artículos</button><button type="button" data-search-filter="Empresa" aria-pressed="false">Empresa</button></div>
  <div class="search-results" data-search-results>
    {% for item in routes %}{% if item.url != '/search/' and item.section != 'Categoría' and item.section != 'Etiqueta' %}
    <article data-search-card data-search-section="{{ item.section }}" data-search-text="{{ item.title }} {{ item.section }} {{ item.description or '' }}"><span>{{ item.section }}</span><h3>{{ item.title }}</h3><p>{{ item.description or 'Información y criterios técnicos de Geo Radar Chile.' }}</p><a href="{{ item.url }}">Abrir contenido <b aria-hidden="true">→</b></a></article>
    {% endif %}{% endfor %}
  </div>
  <div class="search-empty" data-search-empty hidden><span>Sin coincidencias</span><h2>No encontramos esa expresión en el índice.</h2><p>Pruebe con un término más amplio o formule directamente la situación que necesita resolver.</p><div><button type="button" data-search-reset>Limpiar búsqueda</button><a href="/contacto/">Presentar un requerimiento →</a></div></div>
</div></section>
<script>
  (() => {
    const form = document.querySelector('[data-site-search]');
    const input = document.querySelector('#site-search-input');
    const cards = [...document.querySelectorAll('[data-search-card]')];
    const filters = [...document.querySelectorAll('[data-search-filter]')];
    const status = document.querySelector('[data-search-status]');
    const empty = document.querySelector('[data-search-empty]');
    const reset = document.querySelector('[data-search-reset]');
    if (!form || !input || !status || !empty) return;
    let activeFilter = 'all';
    const normalize = value => value.toLocaleLowerCase('es').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    const update = () => {
      const query = normalize(input.value.trim());
      let visible = 0;
      cards.forEach((card, index) => {
        const matchesText = !query || normalize(card.dataset.searchText).includes(query);
        const section = card.dataset.searchSection;
        const matchesFilter = activeFilter === 'all' || section === activeFilter || (activeFilter === 'Servicios' && section === 'Tecnología') || (activeFilter === 'Industrias' && section === 'Aplicaciones');
        const showInitially = query || activeFilter !== 'all' || index < 9;
        const show = matchesText && matchesFilter && showInitially;
        card.hidden = !show;
        if (show) visible += 1;
      });
      empty.hidden = visible !== 0;
      status.textContent = query || activeFilter !== 'all' ? `${visible} ${visible === 1 ? 'resultado' : 'resultados'}.` : 'Mostrando 9 contenidos destacados. Use la búsqueda para consultar todo el sitio.';
    };
    form.addEventListener('submit', event => { event.preventDefault(); update(); });
    input.addEventListener('input', update);
    filters.forEach(button => button.addEventListener('click', () => {
      activeFilter = button.dataset.searchFilter;
      filters.forEach(item => { const active = item === button; item.classList.toggle('is-active', active); item.setAttribute('aria-pressed', active ? 'true' : 'false'); });
      update();
    }));
    reset?.addEventListener('click', () => { input.value = ''; activeFilter = 'all'; filters.forEach((item, index) => { item.classList.toggle('is-active', index === 0); item.setAttribute('aria-pressed', index === 0 ? 'true' : 'false'); }); update(); input.focus(); });
    update();
  })();
</script>

