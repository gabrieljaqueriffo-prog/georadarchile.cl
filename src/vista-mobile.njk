<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>Vista móvil · Geo Radar Chile</title>
  <style>
    :root { color-scheme: dark; font-family: Inter, Arial, sans-serif; }
    * { box-sizing: border-box; }
    body { margin: 0; min-width: 960px; color: #f5f1eb; background: #131516; }
    .review-shell { min-height: 100vh; display: grid; grid-template-columns: 310px 1fr; }
    .review-panel { position: sticky; top: 0; height: 100vh; padding: 34px 28px; background: #1d2224; border-right: 1px solid #353b3d; }
    .review-kicker { margin: 0 0 14px; color: #dd8c68; font-size: 10px; font-weight: 800; letter-spacing: .17em; text-transform: uppercase; }
    h1 { margin: 0; font-size: 27px; line-height: 1.05; letter-spacing: -.04em; }
    .review-intro { margin: 18px 0 30px; color: #b9c0c1; font-size: 13px; line-height: 1.55; }
    label { display: block; margin: 22px 0 8px; color: #aeb5b6; font-size: 10px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
    select, button { width: 100%; min-height: 44px; padding: 10px 12px; color: #f5f1eb; background: #272d2f; border: 1px solid #424a4c; font: inherit; }
    .devices { display: grid; gap: 8px; }
    button { text-align: left; cursor: pointer; }
    button[aria-pressed="true"] { color: white; background: #a64d2d; border-color: #c76a47; }
    .refresh-view { margin-top: 12px; color: #efb095; background: transparent; border-color: #7c4a36; text-align: center; }
    .refresh-view:hover { color: white; background: #7c3c25; }
    .review-note { margin-top: 28px; padding-top: 20px; color: #8f9799; border-top: 1px solid #353b3d; font-size: 11px; line-height: 1.55; }
    .review-stage { min-width: 650px; display: grid; place-items: start center; padding: 32px 48px 80px; overflow: auto; background: radial-gradient(circle at 50% 15%, #303638 0, #202426 42%, #141617 100%); }
    .device-label { width: 100%; display: flex; justify-content: space-between; margin-bottom: 12px; color: #aeb5b6; font-size: 11px; }
    .device-wrap { transition: width .25s ease; }
    .device { padding: 10px; background: #0b0c0d; border: 1px solid #454b4d; border-radius: 30px; box-shadow: 0 28px 80px rgba(0,0,0,.45); }
    .device-top { width: 105px; height: 20px; margin: -1px auto 4px; background: #0b0c0d; border-radius: 0 0 14px 14px; }
    iframe { width: 100%; height: calc(100vh - 105px); min-height: 680px; display: block; background: white; border: 0; border-radius: 18px; }
    .review-hint { margin-top: 15px; color: #899193; font-size: 11px; text-align: center; }
  </style>
</head>
<body>
  <main class="review-shell">
    <aside class="review-panel">
      <p class="review-kicker">Control responsive</p>
      <h1>Vista móvil del sitio</h1>
      <p class="review-intro">Navega dentro del teléfono igual que en un dispositivo real. El contenido del sitio permanece independiente de este marco de revisión.</p>
      <label for="review-page">Página</label>
      <select id="review-page">
        <option value="/servicios/" selected>Servicios</option>
        <option value="/georadar-gpr/">Geo Radar GPR</option>
        <option value="/industrias/">Industrias</option>
        <option value="/construccion/">Construcción</option>
        <option value="/utilities/">Utilities</option>
        <option value="/capacitacion-gpr/">Capacitación GPR</option>
        <option value="/informes-tecnicos/">Informes Técnicos</option>
        <option value="/lem-radio-deteccion/">LEM y Radio Detección</option>
        <option value="/pericias/">Peritajes</option>
        <option value="/instrumentos/">Instrumentos GPR</option>
        <option value="/nosotros/">Nosotros</option>
        <option value="/experiencia/">Experiencia</option>
        <option value="/casos-de-exito/">Casos de Éxito</option>
        <option value="/blog/">Blog y biblioteca</option>
        <option value="/blog/categories/mineria/">Categoría: minería</option>
        <option value="/blog/tags/geo-radar/">Etiqueta: Geo Radar</option>
        <option value="/search/">Buscar en el sitio</option>
        <option value="/post/que-es-georadar-gpr-chile-prospección-no-destructiva-con-georradar-en-chile-gpr/">Artículo: qué es el georradar GPR</option>
        <option value="/post/localizacion-de-tuberias-ductos-con-georadar/">Artículo: tuberías y ductos</option>
        <option value="/post/georradar-en-busqueda-forense/">Artículo: búsqueda forense</option>
        <option value="/post/georadar-o-georradar/">Artículo: georadar o georradar</option>
        <option value="/post/como-funciona-georadar/">Artículo: cómo funciona el GPR</option>
        <option value="/post/georradar-en-mineria-seguridad-antes-de-intervenir/">Artículo: georradar en minería</option>
        <option value="/post/estudio-con-georradar/">Artículo: estudio con georradar</option>
        <option value="/post/servicio-georradar-chile-informe-tecnico/">Artículo: informe técnico</option>
        <option value="/post/georradar-antes-de-excavar/">Artículo: antes de excavar</option>
        <option value="/post/socavones-mineria-chile-deteccion-gpr/">Artículo: detección de socavones</option>
        <option value="/post/capacitacion-en-georradar-gpr-aprender-a-adquirir-procesar-e-interpretar-datos/">Artículo: capacitación GPR</option>
        <option value="/contacto/">Contacto y cotización</option>
        <option value="/">Inicio</option>
        <option value="/mineria/">Minería</option>
      </select>
      <label>Dispositivo</label>
      <div class="devices">
        <button type="button" data-width="320" aria-pressed="false">Móvil compacto · 320 px</button>
        <button type="button" data-width="390" aria-pressed="true">Móvil estándar · 390 px</button>
        <button type="button" data-width="430" aria-pressed="false">Móvil grande · 430 px</button>
        <button type="button" data-width="768" aria-pressed="false">Tablet · 768 px</button>
      </div>
      <button id="refresh-frame" class="refresh-view" type="button">Recargar vista del sitio</button>
      <p class="review-note">Esta herramienta existe solo en la maqueta local y no se publicará como parte del sitio.</p>
    </aside>
    <section class="review-stage" aria-label="Simulación de dispositivo">
      <div id="device-wrap" class="device-wrap" style="width:390px">
        <div class="device-label"><span id="device-name">Móvil estándar</span><span id="device-size">390 × 844</span></div>
        <div class="device"><div class="device-top"></div><iframe id="site-preview" src="/servicios/" title="Vista móvil de Geo Radar Chile"></iframe></div>
        <p class="review-hint">Desplázate dentro del teléfono para revisar la página completa.</p>
      </div>
    </section>
  </main>
  <script>
    const frame = document.querySelector('#site-preview');
    const pageSelect = document.querySelector('#review-page');
    const deviceWrap = document.querySelector('#device-wrap');
    const deviceName = document.querySelector('#device-name');
    const deviceSize = document.querySelector('#device-size');
    const deviceNames = {320: 'Móvil compacto', 390: 'Móvil estándar', 430: 'Móvil grande', 768: 'Tablet'};
    pageSelect.addEventListener('change', () => { frame.src = pageSelect.value; });
    document.querySelector('#refresh-frame').addEventListener('click', () => { frame.contentWindow.location.reload(); });
    document.querySelectorAll('[data-width]').forEach(button => {
      button.addEventListener('click', () => {
        document.querySelectorAll('[data-width]').forEach(item => item.setAttribute('aria-pressed', 'false'));
        button.setAttribute('aria-pressed', 'true');
        const width = button.dataset.width;
        deviceWrap.style.width = width + 'px';
        deviceName.textContent = deviceNames[width];
        deviceSize.textContent = width + ' × 844';
      });
    });
  </script>
</body>
</html>
